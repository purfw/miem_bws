{
  "uid": "confhub-delivery",
  "title": "ConfHub HTTP and delivery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Requests per second", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (service) (rate(http_requests_total[5m]))", "legendFormat": "{{service}}"}]},
    {"id": 2, "title": "HTTP p95 duration", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (service,le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}"}]},
    {"id": 3, "title": "Unfinished queue items", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "confhub_queue_items", "legendFormat": "{{service}} / {{queue}} / {{status}}"}]},
    {"id": 4, "title": "Oldest unfinished item", "type": "timeseries", "datasource": "Prometheus", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "confhub_queue_oldest_age_seconds", "legendFormat": "{{service}} / {{queue}} / {{status}}"}]}
  ]
}
