# Переменные docker-compose.monitoring.yml. manage_monitoring.sh setup
# копирует этот файл в .env; значения заполняются на сервере.

GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Токен бота от @BotFather и чат, куда отправляются алерты.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сеть основного проекта, в которой Prometheus опрашивает сервисы.
APPLICATION_NETWORK=confhub_app
