# Значения генерирует `make secrets`. Файл нужен как перечень переменных,
# копировать его в .env не надо.
POSTGRES_PASSWORD=
SVC_DB_PASSWORD=
SERVICE_TOKEN_SECRET=
JOIN_URL_ENCRYPTION_KEY=
# Optional versioned keyring maintained by scripts/rotate-keys.sh.
JOIN_URL_ENCRYPTION_KEYS=
JOIN_URL_ACTIVE_KEY_VERSION=1

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

SUPPORT_EMAIL=support@confhub.example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@confhub.example.com
SMTP_TLS_MODE=
PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com
PWNED_PASSWORDS_TIMEOUT=5s

# Получаются после регистрации приложения ORCID. Redirect URI:
# https://91.132.58.253/api/v1/auth/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

DJANGO_SECRET_KEY=
# Administrator password hash and TOTP seed are encrypted in secrets/admin-auth.
# Set them interactively with scripts/admin-auth.sh setup .env.
ADMIN_COOKIE_SECURE=false
