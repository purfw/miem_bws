[Unit]
Description=Renew ConfHub internal certificates and rotate service authentication
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/confhub/back
ExecStart=/bin/bash /srv/confhub/back/scripts/rotate-keys.sh --service-only
TimeoutStartSec=10min
UMask=0077
